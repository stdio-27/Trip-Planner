# Gemini API key to generate real trip itineraries
GEMINI_API_KEY=your_gemini_api_key

# Model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Port for the Express proxy server (default: 8787)
PORT=8787

# Mock response modes for offline development / testing
# Valid values: jitter, slow, bad-json, bad-shape, empty, fail
# MOCK=jitter
