# GEMINI_API_KEY is read by Express for live generation. Leave empty for demo mode.
# Backend only. Never add this key to a VITE_ variable or commit a populated .env.
GEMINI_API_KEY=
# GEMINI_MODEL selects the model for itinerary, local-option and fare requests.
# The value below is the server default when this variable is unset.
GEMINI_MODEL=gemini-flash-lite-latest

# PORT is the Express listening port and Vite's API proxy target (default 8787).
PORT=8787
# VITE_DEV_PORT is Vite's requested development port (default 5173).
# Vite may choose another available port if this one is occupied.
VITE_DEV_PORT=5173

# MOCK chooses a response simulation. Leave unset for live Gemini generation.
# MOCK=demo supplies keyless estimates and itineraries. Place search still uses Open-Meteo.
# Keyless examples: demo, geo-down, geo-slow, geo-empty, fares-bad-json,
# fares-fail, journeys-empty, options-bad-shape, options-empty,
# wrong-days, jitter, slow, bad-json, bad-shape, empty, fail
# MOCK=demo
# MOCK_STAGE is optional. Set to plan to isolate a generic response mock to itinerary generation.
# MOCK_STAGE=plan
