# Backend only. Never add this key to a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Express API and Vite development ports
PORT=8787
VITE_DEV_PORT=5173

# Unset MOCK for live Gemini generation.
# Keyless examples: demo, geo-down, geo-slow, geo-empty, fares-bad-json,
# fares-fail, journeys-empty, options-bad-shape, options-empty,
# wrong-days, jitter, slow, bad-json, bad-shape, empty, fail
# MOCK=demo
# Set to plan to isolate a generic response mock to itinerary generation.
# MOCK_STAGE=plan
