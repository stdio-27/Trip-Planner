# Gemini API key to generate real trip itineraries
GEMINI_API_KEY=your_gemini_api_key

# Model name (default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Port for the Express proxy server (default: 8787)
PORT=8787

# Mock response modes for offline development / testing
# Valid values: demo, jitter, slow, bad-json, bad-shape, empty, fail, wrong-days, options-bad-shape, options-empty
# MOCK=jitter
# Geocoding mocks: geo-down, geo-slow, geo-empty
