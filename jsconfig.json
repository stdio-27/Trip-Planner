{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "maxNodeModuleJsDepth": 0,
    "jsx": "react-jsx"
  },
  "include": [
    "shared/*.js",
    "server/*.js",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.js",
    "node_modules",
    "artifacts",
    "dist",
    "**/*.test.jsx"
  ]
}
