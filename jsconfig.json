{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/*.js",
    "server/*.js",
    "src/costs.js"
  ],
  "exclude": [
    "**/*.test.js",
    "node_modules",
    "artifacts",
    "dist"
  ]
}
