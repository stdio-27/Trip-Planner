{
  "name": "trip-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:client\" \"npm:server\"",
    "start": "concurrently -k -n client,server -c cyan,magenta \"npm:client\" \"npm:server\"",
    "start:prod": "npm run build && node server/index.js",
    "client": "vite",
    "server": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p jsconfig.json",
    "data:fetch": "node scripts/build-data/fetch.js",
    "data:build": "node scripts/build-data/build.js && node scripts/build-data/check.js",
    "data:check": "node scripts/build-data/check.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "concurrently": "^9.1.2",
    "csv-parse": "^7.0.3",
    "jsdom": "^31.0.0",
    "stream-json": "^3.9.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
